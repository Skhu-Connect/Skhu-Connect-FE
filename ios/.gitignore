# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
GoogleService-Info.plist
google-services.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# .env*.local 만으로는 .env 가 안 잡힌다. Expo 는 프로젝트 루트의 .env 를 자동으로
# process.env 에 싣고 이 레포는 공개라, 한 번 커밋되면 히스토리에 남는다.
.env*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
